{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /REPLACE_WITH_AGENT_MEMORY_PATH/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /REPLACE_WITH_AGENT_MEMORY_PATH/hooks/index-file.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /REPLACE_WITH_AGENT_MEMORY_PATH/hooks/session-end.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
