{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "bash \"${PLUGIN_ROOT}/hooks/session-start.sh\"",
          "timeout": 30
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Write|Edit|MultiEdit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"${PLUGIN_ROOT}/hooks/index-file.sh\"",
          "timeout": 30
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "bash \"${PLUGIN_ROOT}/hooks/session-end.sh\"",
          "timeout": 15
        }
      ]
    }
  ]
}
